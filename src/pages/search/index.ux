<template>
  <div class="page">
    <text class="h1">搜索</text>
    <input class="search-box" type="text" placeholder="标题 / 作者 / 关键词" onchange="onInput" value="{{ kw }}"></input>
    <scroll scroll-y="true" class="scroll-box">
      <div class="wrap">
        <div class="card" for="{{item in result}}" onclick="open(item.id)">
          <text class="text">{{ item.title }} · {{ item.author }}</text>
        </div>
      </div>
    </scroll>
    <text class="sub" if="{{ kw && result.length === 0 }}">没有找到相关诗词</text>
  </div>
</template>

<script>
  import router from '@blueos.app.appmanager.router'
  import poemsIndex from '../../data/poems-index.js'

  const PAGE_SIZE = 20

  export default {
    data: { kw: '', result: [] },
    onInput(e) {
      const v = (e && (e.value !== undefined ? e.value : e.text)) || ''
      this.kw = v
      const k = v.trim().toLowerCase()
      if (!k) { this.result = []; return }
      const all = poemsIndex.filter(p =>
        p.title.toLowerCase().includes(k) ||
        p.author.toLowerCase().includes(k)
      )
      this.result = all.slice(0, PAGE_SIZE)
    },
    open(id) {
      router.push({ uri: '/pages/detail?id=' + id })
    }
  }
</script>

<style>
  .search-box {
    width: 100%;
    background-color: #FFFFFF;
    border-radius: 20px;
    border: 1px solid #D9C3A0;
    padding: 8px 14px;
    font-size: 20px;
    color: #4A3B2A;
    margin-bottom: 12px;
  }
  .wrap { flex-direction: column; }
  .scroll-box { height: 300px; }
</style>
