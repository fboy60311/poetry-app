<template>
  <div class="page">
    <div class="safe-area" style="{{safeStyle}}">
      <text class="h1">搜索</text>

      <div class="search-row">
        <input
          id="searchInput"
          class="search-box"
          type="text"
          placeholder="标题 / 作者 / 关键词"
          onchange="onInput"
          onfocus="onFocus"
          onblur="onBlur"
          onclick="focusInput"
          value="{{ kw }}"
        ></input>
        <div class="search-btn" onclick="doSearch(kw)">
          <text class="search-btn-text">去搜索</text>
        </div>
      </div>

      <scroll scroll-y="true" class="search-scroll" style="{{scrollStyle}}">
        <div class="result-wrap">
          <div class="result-item" for="{{item in result}}" onclick="open(item.id)">
            <text class="result-title">{{ item.title }}</text>
            <text class="result-author">{{ item.author }}</text>
          </div>
        </div>
        <text class="sub empty" if="{{ kw && result.length === 0 }}">没有找到相关诗词</text>
      </scroll>
    </div>
  </div>
</template>

<script>
  import router from '@blueos.app.appmanager.router'
  import poemsIndex from '../../data/poems-index.js'
  import { getScreenInfo } from '../../utils/screen.js'

  const PAGE_SIZE = 20
  const CONTENT_WIDTH = 320
  const PAGE_PAD = 16

  function makeSafeStyle(info) {
    const ww = info.windowWidth || 466
    const s = info.safeSquareSize || 329
    const margin = Math.max(0, Math.floor((ww - 2 * PAGE_PAD - CONTENT_WIDTH) / 2))
    const h = Math.min(s, ww - 2 * PAGE_PAD - 2 * margin)
    return 'width: ' + CONTENT_WIDTH + 'px; height: ' + h + 'px; margin-left: ' + margin + 'px; margin-top: ' + margin + 'px;'
  }

  function makeScrollStyle(info) {
    const h = (info.safeSquareSize || 329) - 110
    return 'width: 100%; height: ' + Math.max(160, h) + 'px;'
  }

  export default {
    data: {
      kw: '',
      result: [],
      safeStyle: 'width: 320px; height: 320px; margin-left: 57px; margin-top: 57px;',
      scrollStyle: 'width: 100%; height: 210px;'
    },
    onInit() {
      const self = this
      getScreenInfo(function (info) {
        self.safeStyle = makeSafeStyle(info)
        self.scrollStyle = makeScrollStyle(info)
      })
    },
    onInput(e) {
      // BlueOS input 的 change 事件在不同系统版本下字段名可能不同，做兼容处理
      let v = ''
      if (e) {
        if (e.value !== undefined && e.value !== null) {
          v = e.value
        } else if (e.text !== undefined && e.text !== null) {
          v = e.text
        }
      }
      this.kw = String(v)
      console.log('[Search] input value=' + this.kw)
      // 输入完成后自动搜索，用户也可以再点「去搜索」
      this.doSearch(this.kw)
    },
    onFocus() {
      console.log('[Search] input focus')
    },
    onBlur() {
      console.log('[Search] input blur')
    },
    focusInput() {
      // 点击搜索框时主动唤起系统输入法（手写/语音，由系统决定）
      console.log('[Search] input click, try focus searchInput')
      try {
        const el = this.$element('searchInput')
        if (el && el.focus) {
          el.focus()
          console.log('[Search] searchInput.focus() called')
        } else {
          console.log('[Search] searchInput no focus method')
        }
      } catch (err) {
        console.log('[Search] focus error', err)
      }
    },
    doSearch(v) {
      const keyword = (v !== undefined ? v : this.kw) || ''
      this.kw = keyword
      const k = keyword.trim().toLowerCase()
      if (!k) { this.result = []; return }
      const all = poemsIndex.filter(p =>
        p.title.toLowerCase().includes(k) ||
        p.author.toLowerCase().includes(k)
      )
      this.result = all.slice(0, PAGE_SIZE)
    },
    open(id) {
      router.push({ uri: '/pages/detail?id=' + id })
    }
  }
</script>

<style>
  .safe-area {
    flex-direction: column;
    background-color: #FBF3E6;
    padding: 10px 0;
  }
  .h1 {
    font-size: 22px;
    text-align: center;
    margin-bottom: 10px;
  }
  .search-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 10px;
  }
  .search-box {
    width: 206px;
    height: 48px;
    background-color: #FFFFFF;
    border-radius: 24px;
    border: 1px solid #8A6D3B;
    padding: 0 12px;
    font-size: 19px;
    color: #4A3B2A;
    text-align: center;
  }
  .search-btn {
    flex-direction: column;
    justify-content:  center;
    width: 100px;
    height: 48px;
    background-color: #E8B84B;
    border-radius: 24px;
    border: 1px solid #C99A3B;
    text-align: center;
  }
  .search-btn-text {
    font-size: 18px;
    color: #FFFFFF;
    text-align: center;
  }
  .search-scroll {
    flex-direction: column;
  }
  .result-wrap {
    flex-direction: column;
    width: 100%;
  }
  .result-item {
    flex-direction: column;
    width: 100%;
    background-color: #FFFDF8;
    border: 1px solid #D9C3A0;
    border-radius: 12px;
    padding: 8px 10px;
    margin-bottom: 8px;
  }
  .result-title {
    font-size: 16px;
    color: #4A3B2A;
    line-height: 24px;
    margin-bottom: 2px;
  }
  .result-author {
    font-size: 14px;
    color: #6B4F2A;
    line-height: 20px;
  }
  .empty {
    text-align: center;
    font-size: 15px;
    margin-top: 12px;
  }
</style>
