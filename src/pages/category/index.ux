<template>
  <div class="page">
    <text class="h1">分类浏览</text>
    <scroll scroll-y class="scroll-box">
      <div class="wrap">
        <div class="tile" for="{{it in items}}" onclick="openDynasty(it.value)">
          <text class="lab">{{ it.label }}</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
  import router from '@blueos.app.appmanager.router'
  import poemsIndex from '../../data/poems-index.js'

  const ORDER = ['先秦','周','汉','战国','魏晋','南北朝','唐','宋','元','明','清','近代']
  const LABEL = {
    '周':'周(诗经)','汉':'汉','战国':'战国','魏晋':'魏晋','南北朝':'南北朝',
    '唐':'唐','宋':'宋','元':'元','明':'明','清':'清','近代':'近代','先秦':'先秦'
  }

  export default {
    data: { items: [] },
    onInit() {
      const counts = {}
      poemsIndex.forEach(p => { counts[p.dynasty] = (counts[p.dynasty] || 0) + 1 })
      const dyn = Object.keys(counts).sort((a, b) => {
        const ia = ORDER.indexOf(a), ib = ORDER.indexOf(b)
        return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib)
      })
      const items = [{ value: 'all', label: '全部 (' + poemsIndex.length + '首)' }]
      dyn.forEach(d => items.push({ value: d, label: (LABEL[d] || d) + ' (' + counts[d] + '首)' }))
      this.items = items
    },
    openDynasty(v) {
      router.push({ uri: '/pages/list?type=dynasty&value=' + encodeURIComponent(v) })
    }
  }
</script>

<style>
  .wrap { flex-direction: column; }
  .scroll-box { height: 360px; }
  .tile {
    width: 100%;
    background-color: #FFFDF8;
    border: 1px solid #E4D5B7;
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 12px;
  }
  .lab { font-size: 22px; color: #6B4F2A; text-align: center; }
</style>
