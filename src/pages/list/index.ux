<template>
  <div class="page">
    <text class="h1">{{ title }}</text>
    <scroll scroll-y="true" class="scroll-box">
      <div class="wrap">
        <div class="card" for="{{item in list}}" onclick="open(item.id)">
          <text class="text">{{ item.title }} · {{ item.author }}</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
  import router from '@blueos.app.appmanager.router'
  import poemsIndex from '../../data/poems-index.js'

  const PAGE_SIZE = 20

  export default {
    data: { list: [], title: '', type: '', value: '' },
    onInit() {
      const type = this.type || 'dynasty'
      const value = (this.value ? decodeURIComponent(this.value) : '唐')
      this.title = value === 'all' ? '全部诗词' : value
      let all = []
      if (type === 'dynasty') {
        if (value === 'all') all = poemsIndex.slice()
        else all = poemsIndex.filter(p => p.dynasty === value)
      } else {
        all = poemsIndex.filter(p => p.author === value)
      }
      this.list = all.slice(0, PAGE_SIZE)
    },
    open(id) {
      router.push({ uri: '/pages/detail?id=' + id })
    }
  }
</script>

<style>
  .wrap { flex-direction: column; }
  .scroll-box { height: 360px; }
</style>
