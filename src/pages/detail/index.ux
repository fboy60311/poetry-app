<template>
  <div class="page">
    <text class="h1">{{ poem.title }}</text>
    <text class="sub">{{ poem.dynasty }} · {{ poem.author }}</text>

    <div class="tabs">
      <div class="tab {{ tab==='content' ? 'on' : '' }} tab-1" onclick="setTab('content')"><text class="tab-t">正文</text></div>
      <div class="tab {{ tab==='zhushi' ? 'on' : '' }} tab-2" onclick="setTab('zhushi')"><text class="tab-t">注释</text></div>
      <div class="tab {{ tab==='note' ? 'on' : '' }} tab-3" onclick="setTab('note')"><text class="tab-t">译注</text></div>
    </div>

    <scroll scroll-y class="scroll-box">
      <text class="text line" for="{{line in lines}}">{{ line }}</text>
    </scroll>

    <div class="row">
      <div class="btn btn-left" onclick="toggle"><text class="btn-text">{{ fav ? '已收藏' : '收藏' }}</text></div>
      <div class="btn btn-right" onclick="goBack"><text class="btn-text">返回</text></div>
    </div>
  </div>
</template>

<script>
  import router from '@blueos.app.appmanager.router'
  import poems from '../../data/poems.js'
  import { toggleFav, isFav } from '../../utils/store.js'

  export default {
    data: {
      id: '',
      pid: 0,
      poem: {},
      fav: false,
      tab: 'content',
      lines: []
    },
    onInit() {
      const id = Number(this.id) || 1
      this.pid = id
      const p = poems.find(x => x.id === id) || poems[0]
      this.poem = p
      this.updateLines()
      isFav(id).then(v => { this.fav = v })
    },
    updateLines() {
      const p = this.poem || {}
      let t = ''
      if (this.tab === 'content') t = p.content || ''
      else if (this.tab === 'zhushi') t = p.zhushi || '暂无注释'
      else t = p.note || '暂无译注'
      this.lines = t.split('\n').map(s => s.trim()).filter(s => s.length > 0)
      if (this.lines.length === 0) this.lines = ['暂无内容']
    },
    setTab(t) {
      this.tab = t
      this.updateLines()
    },
    toggle() {
      toggleFav(this.pid).then(() => { this.fav = !this.fav })
    },
    goBack() {
      router.back()
    }
  }
</script>

<style>
  .tabs {
    position: relative;
    width: 100%;
    height: 50px;
    margin-bottom: 12px;
  }
  .tab {
    position: absolute;
    top: 0;
    width: 130px;
    height: 50px;
    background-color: #FFFDF8;
    border: 1px solid #E4D5B7;
    border-radius: 16px;
    text-align: center;
  }
  .tab-1 { left: 10px; }
  .tab-2 { left: 152px; }
  .tab-3 { left: 294px; }
  .tab.on {
    background-color: #F3E4C7;
    border-color: #D9C3A0;
  }
  .tab-t { font-size: 20px; color: #6B4F2A; }

  .scroll-box { height: 210px; margin-bottom: 12px; }
  .line { margin-bottom: 10px; }
</style>
