<template>
  <div class="page">
    <scroll scroll-y="true" class="scroll-box">
      <div class="wrap">
        <text class="h1">{{ title }}</text>
        <text class="sub">{{ dynasty }} · {{ author }}</text>

        <div class="btn {{ tab==='content' ? 'on' : '' }}" onclick="setTab('content')">
          <text class="btn-text">正文</text>
        </div>
        <div class="btn {{ tab==='zhushi' ? 'on' : '' }}" onclick="setTab('zhushi')">
          <text class="btn-text">注释</text>
        </div>
        <div class="btn {{ tab==='note' ? 'on' : '' }}" onclick="setTab('note')">
          <text class="btn-text">译注</text>
        </div>

        <div class="card">
          <text class="text line" for="{{line in lines}}">{{ line }}</text>
        </div>

        <div class="btn" onclick="toggle"><text class="btn-text">{{ fav ? '已收藏' : '收藏' }}</text></div>
        <div class="btn" onclick="goBack"><text class="btn-text">返回</text></div>
      </div>
    </scroll>
  </div>
</template>

<script>
  import router from '@blueos.app.appmanager.router'
  import poems from '../../data/poems.js'
  import { toggleFav, isFav } from '../../utils/store.js'

  function pickText(p, key) {
    const t = p[key] || ''
    const arr = t.split('\n').map(s => s.trim()).filter(s => s.length > 0)
    return arr.length > 0 ? arr : ['暂无内容']
  }

  export default {
    data: {
      id: '',
      pid: 0,
      title: '',
      author: '',
      dynasty: '',
      content: '',
      zhushi: '',
      note: '',
      fav: false,
      tab: 'content',
      lines: []
    },
    onInit() {
      const id = Number(this.id) || 1
      this.pid = id
      const p = poems.find(x => x.id === id) || poems[0]
      this.title = p.title
      this.author = p.author
      this.dynasty = p.dynasty
      this.content = p.content
      this.zhushi = p.zhushi
      this.note = p.note
      this.updateLines()
      isFav(id).then(v => { this.fav = v })
    },
    updateLines() {
      this.lines = pickText({ content: this.content, zhushi: this.zhushi, note: this.note }, this.tab)
    },
    setTab(t) {
      this.tab = t
      this.updateLines()
    },
    toggle() {
      toggleFav(this.pid).then(() => { this.fav = !this.fav })
    },
    goBack() {
      router.back()
    }
  }
</script>

<style>
  .wrap { flex-direction: column; }
  .line { margin-bottom: 10px; }
</style>
