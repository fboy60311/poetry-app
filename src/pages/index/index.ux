    font-size: 32px;
    color: #8A6D3B;
    font-weight: 500;
    text-align: center;
    margin-bottom: 6px;
  }
  .sub {
    font-size: 20px;
    color: #B08A4F;
    text-align: center;
    margin-bottom: 14px;
  }
  .sub.sec {
    margin-top: 8px;
  }
  .card {
    flex-direction: column;
    background-color: #FFFDF8;
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 14px;
    border: 1px solid #E4D5B7;
    width: 100%;
  }
  .card-title {
    font-size: 20px;
    color: #B08A4F;
    margin-bottom: 6px;
    text-align: center;
  }
  .text {
    font-size: 22px;
    color: #4A3B2A;
    line-height: 36px;
    text-align: center;
  }
  .small {
    font-size: 18px;
    color: #6B4F2A;
    line-height: 30px;
    text-align: center;
  }
  .home-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
  }
  .grid-btn {
    flex-direction: column;
    justify-content: center;
    width: 200px;
    height: 60px;
    background-color: #F3E4C7;
    border-radius: 20px;
    border: 1px solid #D9C3A0;
    text-align: center;
    margin-bottom: 12px;
  }
  .btn-text {
    font-size: 22px;
    color: #6B4F2A;
    text-align: center;
  }
  .author {
    flex-direction: column;
    width: 100%;
    background-color: #FFFDF8;
    border: 1px solid #E4D5B7;
    border-radius: 12px;
    padding: 12px;
    margin-bottom: 10px;
  }
</style>
