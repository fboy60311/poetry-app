<template>
  <div class="page">
    <scroll scroll-y="true" class="scroll-box">
      <div class="home-wrap">
        <text class="h1">古诗词</text>
        <text class="sub">腕上诗心 · 每日一阅</text>

        <div class="card" onclick="openToday">
          <text class="card-title">今日诗词</text>
          <text class="text">{{ today.title }}</text>
          <text class="small">{{ today.dynasty }} · {{ today.author }}</text>
        </div>

        <div class="home-grid">
          <div class="grid-btn" onclick="goCategory"><text class="btn-text">按朝代</text></div>
          <div class="grid-btn" onclick="goRandom"><text class="btn-text">随机一首</text></div>
          <div class="grid-btn" onclick="goSearch"><text class="btn-text">搜索</text></div>
          <div class="grid-btn" onclick="goFav"><text class="btn-text">我的收藏</text></div>
        </div>

        <text class="sub sec">热门作者</text>
        <div class="author" for="{{a in hotAuthors}}" onclick="goAuthor(a.name)">
          <text class="text">{{ a.name }}（{{ a.count }}首）</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
  import router from '@blueos.app.appmanager.router'
  import poemsIndex from '../../data/poems-index.js'

  function pickDaily() {
    const day = new Date().getDate() % poemsIndex.length
    return poemsIndex[day]
  }

  function topAuthors(n) {
    const counts = {}
    poemsIndex.forEach(p => { counts[p.author] = (counts[p.author] || 0) + 1 })
    const arr = Object.keys(counts).map(name => ({ name: name, count: counts[name] }))
    arr.sort((a, b) => b.count - a.count)
    return arr.slice(0, n)
  }

  export default {
    data: {
      today: { id: 1, title: '', author: '', dynasty: '' },
      hotAuthors: []
    },
    onInit() {
      this.today = pickDaily()
      this.hotAuthors = topAuthors(6)
    },
    openToday() {
      router.push({ uri: '/pages/detail?id=' + this.today.id })
    },
    goCategory() {
      router.push({ uri: '/pages/category' })
    },
    goRandom() {
      const p = poemsIndex[Math.floor(Math.random() * poemsIndex.length)]
      router.push({ uri: '/pages/detail?id=' + p.id })
    },
    goSearch() {
      router.push({ uri: '/pages/search' })
    },
    goFav() {
      router.push({ uri: '/pages/favorites' })
    },
    goAuthor(name) {
      router.push({ uri: '/pages/list?type=author&value=' + encodeURIComponent(name) })
    }
  }
</script>

