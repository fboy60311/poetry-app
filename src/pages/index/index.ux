<template>
  <div class="page">
    <scroll scroll-y class="scroll-box">
      <text class="h1">古诗词</text>
      <text class="sub">腕上诗心 · 每日一阅</text>

      <div class="today-card" onclick="openToday">
        <text class="today-label">今日诗词</text>
        <text class="today-title">{{ today.title }}</text>
        <text class="today-author">{{ today.dynasty }} · {{ today.author }}</text>
      </div>

      <div class="btn" onclick="goCategory">
        <text class="btn-emoji">📜</text>
        <text class="btn-text">按朝代</text>
      </div>
      <div class="btn" onclick="goRandom">
        <text class="btn-emoji">🎲</text>
        <text class="btn-text">随机一首</text>
      </div>
      <div class="btn" onclick="goSearch">
        <text class="btn-emoji">🔍</text>
        <text class="btn-text">搜索</text>
      </div>
      <div class="btn" onclick="goFavorites">
        <text class="btn-emoji">❤️</text>
        <text class="btn-text">我的收藏</text>
      </div>
    </scroll>
  </div>
</template>

<script>
  import router from '@blueos.app.appmanager.router'
  import poems from '../../data/poems.js'

  export default {
    data: {
      today: {}
    },
    onInit() {
      const d = new Date()
      this.today = poems[d.getDate() % poems.length]
    },
    openToday() {
      router.push({ uri: '/pages/detail?id=' + this.today.id })
    },
    goRandom() {
      const p = poems[Math.floor(Math.random() * poems.length)]
      router.push({ uri: '/pages/detail?id=' + p.id })
    },
    goCategory() { router.push({ uri: '/pages/category' }) },
    goFavorites() { router.push({ uri: '/pages/favorites' }) },
    goSearch() { router.push({ uri: '/pages/search' }) }
  }
</script>

<style>
  .scroll-box { height: 466px; }
  .today-card {
    background-color: #F3E4C7;
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 14px;
    border: 1px solid #E4D5B7;
  }
  .today-label {
    font-size: 18px;
    color: #B08A4F;
    margin-bottom: 6px;
  }
  .today-title {
    font-size: 26px;
    color: #4A3B2A;
    margin-bottom: 6px;
  }
  .today-author {
    font-size: 18px;
    color: #6B4F2A;
  }
</style>
