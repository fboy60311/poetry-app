<template>
  <div class="page">
    <text class="h1">我的收藏</text>
    <scroll scroll-y class="scroll-box">
      <div class="card" for="{{item in list}}" onclick="open(item.id)">
        <text class="text">{{ item.title }} · {{ item.author }}</text>
      </div>
    </scroll>
    <text class="sub" if="{{ list.length === 0 }}">还没有收藏，去详情页点“收藏”吧</text>
  </div>
</template>

<script>
  import router from '@blueos.app.appmanager.router'
  import poems from '../../data/poems.js'
  import { getFavIds } from '../../utils/store.js'

  export default {
    data: { list: [] },
    onInit() {
      getFavIds().then(ids => {
        this.list = poems.filter(p => ids.indexOf(p.id) >= 0)
      })
    },
    open(id) {
      router.push({ uri: '/pages/detail?id=' + id })
    }
  }
}
</script>

<style>
  .scroll-box { height: 360px; }
</style>
