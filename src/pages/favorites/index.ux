<template>
  <div class="page">
    <text class="h1">我的收藏</text>
    <scroll scroll-y="true" class="scroll-box">
      <div class="wrap">
        <div class="card" for="{{item in list}}" onclick="open(item.id)">
          <text class="text">{{ item.title }} · {{ item.author }}</text>
        </div>
      </div>
    </scroll>
    <text class="sub" if="{{ list.length === 0 }}">还没有收藏，去详情页点“收藏”吧</text>
  </div>
</template>

<script>
  import router from '@blueos.app.appmanager.router'
  import poemsIndex from '../../data/poems-index.js'
  import { getFavIds } from '../../utils/store.js'

  export default {
    data: { list: [] },
    onInit() {
      getFavIds().then(ids => {
        const all = poemsIndex.filter(p => ids.indexOf(p.id) >= 0)
        this.list = all.slice(0, 20)
      })
    },
    open(id) {
      router.push({ uri: '/pages/detail?id=' + id })
    }
  }
</script>

<style>
  .wrap { flex-direction: column; }
  .scroll-box { height: 360px; }
</style>
